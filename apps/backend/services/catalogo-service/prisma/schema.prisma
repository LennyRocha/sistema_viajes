generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Conductor {
  id Int @id @default(autoincrement())

  usuario_id Int @unique

  // Relación con la institución
  institucion_id Int
  institucion    Institucion @relation(fields: [institucion_id], references: [id])

  // Relaciones
  licencias Licencia[]

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(50)
  updatedBy String?  @db.VarChar(50)

  estatus Boolean @default(true)

  @@index([institucion_id])
}

model Licencia {
  id Int @id @default(autoincrement())

  conductor_id Int
  conductor    Conductor @relation(fields: [conductor_id], references: [id], onDelete: Cascade)

  numero_licencia   String   @unique @db.VarChar(30)
  categoria         String   @db.VarChar(20)
  fecha_expedicion  DateTime @db.Date
  fecha_vencimiento DateTime @db.Date
  estado_emisor     String   @db.VarChar(100)
  imagen_licencia   String   @db.VarChar(255)

  vigente Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conductor_id])
}

model Autobus {
  id             Int    @id @default(autoincrement())
  codigo_interno String @unique @db.VarChar(10)
  marca          String @db.VarChar(255)
  alias          String @unique @db.VarChar(25)
  modelo         String @db.VarChar(255)
  ano            Int
  capacidad      Int
  estado         Estado @default(DISPONIBLE)
  color          String @db.VarChar(25)
  descripcion    String @db.VarChar(255)
  asientos       Json
  slug           String @unique @db.VarChar(100)

  institucion_id  Int
  institucion     Institucion @relation(fields: [institucion_id], references: [id])
  tipo_autobus_id Int
  tipoAutobus     TipoAutobus @relation(fields: [tipo_autobus_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(50)
  updatedBy String?  @db.VarChar(50)

  estatus Boolean @default(true)

  servicios AutobusServicio[]
}

model TipoAutobus {
  id          Int    @id @default(autoincrement())
  nombre      String @unique @db.VarChar(50)
  descripcion String @db.VarChar(100)
  linea       String @db.VarChar(10)
  capacidad   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviciosPorTipos DisponibilidadServicio[]
  autobuses         Autobus[]
}

model Servicio {
  id           Int    @id @default(autoincrement())
  nombre       String @unique @db.VarChar(100)
  icono_nombre String @db.VarChar(50)
  descripcion  String @db.VarChar(500)
  propiedades  Json
  slug         String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(50)
  updatedBy String?  @db.VarChar(50)

  estatus Boolean @default(true)

  serviciosPorTipos DisponibilidadServicio[]
  autobusServicios  AutobusServicio[]
}

enum Estado {
  DISPONIBLE
  EN_RUTA
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Institucion {
  id          Int    @id @default(autoincrement())
  nombre      String @unique @db.VarChar(100)
  descripcion String @db.VarChar(255)
  imagen_url  String @db.VarChar(255)
  slug        String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(50)
  updatedBy String?  @db.VarChar(50)

  estatus Boolean @default(true)

  autobuses            Autobus[]
  conductores          Conductor[]
  serviciosDisponibles DisponibilidadServicio[]
}

model DisponibilidadServicio {
  id              Int @id @default(autoincrement())
  tipo_autobus_id Int
  servicio_id     Int
  institucion_id  Int

  activo Boolean @default(true)

  tipo_autobus TipoAutobus @relation(fields: [tipo_autobus_id], references: [id])
  servicio     Servicio    @relation(fields: [servicio_id], references: [id])
  institucion  Institucion @relation(fields: [institucion_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo_autobus_id, servicio_id, institucion_id])
}

model AutobusServicio {
  id              Int     @id @default(autoincrement())
  config_servicio Json
  autobus_id      Int
  servicio_id     Int
  activo          Boolean @default(true)

  autobus  Autobus  @relation(fields: [autobus_id], references: [id])
  servicio Servicio @relation(fields: [servicio_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([autobus_id, servicio_id])
}
