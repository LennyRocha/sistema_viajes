generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["operaciones"]
}

model ConfiguracionOperacion {
  id          Int      @id @default(autoincrement())
  clave       String   @unique @db.VarChar(80)
  valor       Json
  descripcion String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("operaciones")
}

model Ruta {
  id               Int      @id @default(autoincrement())
  nombre           String   @unique @db.VarChar(120)
  descripcion      String?  @db.VarChar(500)
  origen           Json
  destino          Json
  paradas          Json
  waypoints        Json?
  encodedPolyline  String?  @db.Text
  distanciaMetros  Int?
  duracionSegundos Int?
  estatus          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?  @db.VarChar(50)
  updatedBy        String?  @db.VarChar(50)

  viajes  ViajeBaseRuta[]
  boletos Compra[]

  @@schema("operaciones")
}

model ViajeBase {
  id                   Int      @id @default(autoincrement())
  nombre               String   @unique @db.VarChar(120)
  descripcion          String?  @db.VarChar(500)
  frecuencia           String?  @db.VarChar(80)
  duracionCalculadaMin Int?
  margenMin            Int      @default(0)
  duracionTotalMin     Int?
  imagenUrl            String?  @db.Text
  imagenBase64         String?  @db.Text
  imagenStorage        String?  @db.VarChar(20)
  config_rutas         Json
  estatus              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdBy            String?  @db.VarChar(50)
  updatedBy            String?  @db.VarChar(50)

  rutas   ViajeBaseRuta[]
  salidas Salida[]

  @@schema("operaciones")
}

model ViajeBaseRuta {
  id                      Int      @id @default(autoincrement())
  viajeBaseId             Int
  rutaId                  Int
  orden                   Int
  conexion                Json?
  conexionEncodedPolyline String?  @db.Text
  distanciaConexionMetros Int?
  requiereConexion        Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  viajeBase ViajeBase @relation(fields: [viajeBaseId], references: [id], onDelete: Cascade)
  ruta      Ruta      @relation(fields: [rutaId], references: [id])

  @@unique([viajeBaseId, orden])
  @@unique([viajeBaseId, rutaId, orden])
  @@schema("operaciones")
}

enum TipoSalida {
  UNICA
  RECURRENTE
  ESPECIAL

  @@schema("operaciones")
}

enum EstadoSalida {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO

  @@schema("operaciones")
}

model Salida {
  id Int @id @default(autoincrement())

  //Ids de otro microservicio que no están en este esquema
  autobusId   Int
  conductorId Int

  viajeBaseId Int
  viaje       ViajeBase @relation(fields: [viajeBaseId], references: [id])

  horario_configuracion Json

  tipoSalida   TipoSalida   @default(UNICA)
  estadoSalida EstadoSalida @default(PROGRAMADO)

  precios Json

  capacidadTotal Int
  asientosLayout Json

  boletos Compra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(50)
  updatedBy String?  @db.VarChar(50)

  estatus Boolean @default(false)

  @@schema("operaciones")
}

enum EstadoCompra {
  PENDIENTE
  CONFIRMADA
  CANCELADA

  @@schema("operaciones")
}

//Tipos unicos fecha y hora directa,

model Compra {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid()) @db.VarChar(100)

  salidaId    Int
  compradorId Int
  comprador   Comprador @relation(fields: [compradorId], references: [id])
  salida      Salida    @relation(fields: [salidaId], references: [id])

  pasajeros Int

  asientos Json

  fechaCompra DateTime @default(now())
  monto       Decimal  @db.Decimal(10, 2)
  rutaId      Int
  ruta        Ruta     @relation(fields: [rutaId], references: [id])

  codigo String @unique @db.VarChar(20)

  estado   EstadoCompra @default(PENDIENTE)
  expiraEn DateTime?    // límite para completar el pago; libera la reserva de asientos si se vence

  pagos Pago[]

  //Al momento de escanear el QR code, se debe marcar como abordado, y no permitir que se vuelva a escanear, para evitar duplicidad de abordaje.
  abordado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salidaId, compradorId, fechaCompra])
  @@index([compradorId, salidaId, fechaCompra])
  @@index([salidaId, estado])
  @@schema("operaciones")
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO

  @@schema("operaciones")
}

model Pago {
  id       Int    @id @default(autoincrement())
  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  metodoPagoId Int
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id])

  monto      Decimal    @db.Decimal(10, 2)
  estado     EstadoPago @default(PENDIENTE)
  referencia String?    @db.VarChar(150) // id de transacción de la pasarela
  respuesta  Json?       // payload crudo de la pasarela, para trazabilidad/debug

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compraId, estado])
  @@schema("operaciones")
}

model MetodoPago {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String  @db.VarChar(255)
  estatus     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pagos     Pago[]

  @@index([nombre])
  @@schema("operaciones")
}

//Ruta de ida y vuelta, con asientos reservados, con QR code, con fecha de compra y monto total.

model Comprador {
  id Int @id @default(autoincrement())

  // Datos personales
  nombres          String   @db.VarChar(100)
  apellido_paterno String   @db.VarChar(100)
  apellido_materno String   @db.VarChar(100)
  telefono         String   @unique @db.VarChar(15)
  email            String   @unique @db.VarChar(150)
  compras          Compra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, telefono])
  @@schema("operaciones")
}